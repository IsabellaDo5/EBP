                       'id_mesa': id_mesa,
                       'MEDIA_URL': settings.MEDIA_URL,})
    
def obtener_clientes():
     with connection.cursor() as cursor:
         return cursor.execute("exec VerClientes").fetchall()
     
def obtener_bebidas():
     with connection.cursor() as cursor:
         return cursor.execute("SELECT * FROM VerMenu").fetchall()

def obtener_platillos():
     with connection.cursor() as cursor:
          return cursor.execute("SELECT * FROM platillos").fetchall()